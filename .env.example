# Copiar este archivo como ".env" y completar los valores.

# Puerto del backend
PORT=3001

# Entorno: development | production
NODE_ENV=development

# Cadena de conexion a MongoDB (Atlas o local)
MONGO_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/Comanderos?retryWrites=true&w=majority&appName=Cluster0

# Secreto con el que se firman los JWT.
# OBLIGATORIO en produccion: si falta, el servidor no arranca.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_esto_por_un_valor_aleatorio_largo

# Origenes permitidos por CORS (separados por coma).
# IMPORTANTE: el origen debe coincidir EXACTAMENTE con el que aparece en la
# barra de direcciones del navegador. Si se abre en localhost y la lista solo
# tiene 127.0.0.1 (o al reves), el navegador bloquea TODAS las peticiones y
# la app falla con "Failed to fetch" sin dar explicaciones.
# Por eso se listan las dos variantes del entorno local.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
