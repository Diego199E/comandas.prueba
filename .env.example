# Copiar este archivo como ".env" y completar los valores.

# Puerto del backend
PORT=3001

# Entorno: development | production
NODE_ENV=development

# Cadena de conexion a MongoDB (Atlas o local)
MONGO_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/Comanderos?retryWrites=true&w=majority&appName=Cluster0

# Secreto con el que se firman los JWT.
# OBLIGATORIO en produccion: si falta, el servidor no arranca.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_esto_por_un_valor_aleatorio_largo

# Origenes permitidos por CORS (separados por coma).
# En PRODUCCION la lista es estricta: solo el dominio del frontend.
# En DESARROLLO el backend permite ademas cualquier puerto de localhost,
# porque el puerto de Vite no es fijo (si otro proyecto ocupa el 5173, Vite
# arranca en el 5174) y con una lista fija la app falla con
# "blocked by CORS policy" sin dar explicaciones.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://tu-frontend.vercel.app
