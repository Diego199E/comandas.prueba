# Copiar este archivo como ".env" y completar los valores.

# Puerto del backend
PORT=3001

# Entorno: development | production
NODE_ENV=development

# Cadena de conexion a MongoDB (Atlas o local)
MONGO_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/Comanderos?retryWrites=true&w=majority&appName=Cluster0

# Secreto con el que se firman los JWT.
# OBLIGATORIO en produccion: si falta, el servidor no arranca.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_esto_por_un_valor_aleatorio_largo

# Origenes permitidos por CORS (separados por coma)
CLIENT_ORIGIN=http://localhost:5173
